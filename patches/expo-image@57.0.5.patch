+package expo.modules.image
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class ExpoImageAppGlideModuleTest {
+  @Test
+  fun capsMemoryAndBitmapPoolAt1080p() {
+    val (memory, bitmapPool) = tvGlideCacheSizes(1920, Long.MAX_VALUE, Long.MAX_VALUE)
+    assertEquals(16L * 1024 * 1024, memory)
+    assertEquals(8L * 1024 * 1024, bitmapPool)
+  }
+
+  @Test
+  fun scalesTheBudgetsFor4k() {
+    val (memory, bitmapPool) = tvGlideCacheSizes(3840, Long.MAX_VALUE, Long.MAX_VALUE)
+    assertEquals(64L * 1024 * 1024, memory)
+    assertEquals(32L * 1024 * 1024, bitmapPool)
+  }
+
+  @Test
+  fun neverRaisesGlidesLowMemoryDefaults() {
+    val (memory, bitmapPool) = tvGlideCacheSizes(1920, 4L * 1024 * 1024, 0)
+    assertEquals(4L * 1024 * 1024, memory)
+    assertEquals(0L, bitmapPool)
+  }
+}
