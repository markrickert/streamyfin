+import com.bumptech.glide.load.engine.cache.MemorySizeCalculator
 import com.bumptech.glide.module.AppGlideModule
+import kotlin.math.roundToLong
+
+// Match Streamyfin's screen-scaled TV artwork budget in constants/Images.ts.
+internal fun tvGlideCacheSizes(
+  screenWidthPx: Int,
+  defaultMemoryBytes: Long,
+  defaultBitmapPoolBytes: Long
+): Pair<Long, Long> {
+  val screenScale = screenWidthPx.toDouble() / 1920.0
+  val budget = (16.0 * 1024 * 1024 * screenScale * screenScale).roundToLong()
+  return minOf(defaultMemoryBytes, budget) to minOf(defaultBitmapPoolBytes, budget / 2)
+}
 
